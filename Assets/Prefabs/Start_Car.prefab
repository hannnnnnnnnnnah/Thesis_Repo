  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "I don't know if you'll see this. Honestly, I'm not even sure you'll care,
    but for some reason I felt like you should know. I'm going to the place we met
    and I'm leaving. For good. I can't just move on like nothing happened. I'm not
    like you. If you would have been there when I needed you maybe things could be
    different but it's too late.  \nGoodbye.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b3bdff048cac6094997cc4a5d6e6c395, type: 2}
